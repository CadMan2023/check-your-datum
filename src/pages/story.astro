---
import "../styles/datum-pages.css";

const navItems = [
  { href: "/writing", label: "Writing" },
  { href: "/story", label: "Story", current: true },
  { href: "/book", label: "Book" },
  { href: "/cadvantage", label: "CADVANTAGE" },
  { href: "#join", label: "Join" },
];

const principles = [
  {
    title: "Reference first",
    kicker: "Datum",
    copy: "Start with the surface that tells the truth. The rest of the work depends on it.",
  },
  {
    title: "Attention over noise",
    kicker: "Practice",
    copy: "DATUM is built for careful reading, useful tools, and the discipline of seeing what is actually there.",
  },
  {
    title: "Record the marks",
    kicker: "Writing",
    copy: "The work is easier to trust when the setup, the mistakes, and the corrections are written down plainly.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Story | DATUM</title>
    <meta
      name="description"
      content="The story behind DATUM: a public writing and tools system by Thomas Craft built from reference, craft, attention, and shop truth."
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label="DATUM home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>DATUM</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <section class="page-hero" aria-labelledby="page-title">
          <div>
            <p class="eyebrow">DATUM / by Thomas Craft</p>
            <h1 id="page-title">The Story</h1>
            <p class="lead">
              DATUM is a system built from reference, craft, shop truth, attention, and writing.
            </p>
            <p class="body-copy">
              It comes from a simple working belief: if the reference is false, the correction
              will wander. That is true at the bench, in the notebook, and in the life around both.
            </p>
          </div>

          <div class="hero-plate" aria-label="Abstract datum reference plate">
            <span class="plate-label">Story / Setup</span>
          </div>
        </section>

        <section class="section" aria-labelledby="about-title">
          <div class="split-feature">
            <div>
              <p class="eyebrow">Public voice</p>
              <h2 id="about-title">Thomas Craft</h2>
            </div>
            <div class="feature-copy">
              <p>
                Thomas Craft is the public author and maker voice behind DATUM. The work sits
                where shop practice, honest measurement, mental clarity, and literary attention meet.
              </p>
              <p>
                This is not a performance of toughness or a brand costume. It is a working
                notebook made public: what the bench teaches, what the writing keeps, and what
                becomes clearer when the datum is checked.
              </p>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="principles-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">How it works</p>
              <h2 id="principles-title">The standard is practical.</h2>
            </div>
            <p>DATUM keeps the language grounded because the work itself is grounded.</p>
          </div>

          <div class="card-grid three">
            {
              principles.map((item) => (
                <article class="card">
                  <p class="kicker">{item.kicker}</p>
                  <h3>{item.title}</h3>
                  <span class="rule" aria-hidden="true"></span>
                  <p>{item.copy}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section" aria-labelledby="exists-title">
          <div class="quote-band">
            <p id="exists-title">
              Start from something true. Measure honestly. Build carefully. Leave it better.
            </p>
          </div>
        </section>

        <section class="section" id="join" aria-labelledby="join-title">
          <div class="join-block">
            <div>
              <p class="eyebrow">Bench Notes</p>
              <h2 id="join-title">Follow the work.</h2>
              <p>
                Short dispatches on craft, clarity, tools, and the work of checking your datum.
              </p>
            </div>

            <!-- STUB: not wired to an email provider yet. Wiring is a separate ticket. -->
            <form class="signup-form">
              <label for="email">Email address</label>
              <div class="form-row">
                <input id="email" name="email" type="email" placeholder="you@example.com" required />
                <button type="submit">Subscribe</button>
              </div>
            </form>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <p>Thomas Craft &middot; checkyourdatum.com</p>
      </footer>
    </div>
  </body>
</html>
