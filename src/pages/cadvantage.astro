---
import "../styles/datum-pages.css";

const navItems = [
  { href: "/writing", label: "Writing" },
  { href: "/story", label: "Story" },
  { href: "/book", label: "Book" },
  { href: "/cadvantage", label: "CADVANTAGE", current: true },
  { href: "#join", label: "Join" },
];

const utilityNotes = [
  "Calculators for common shop questions and repeatable checks.",
  "Setup thinking that keeps geometry, reference, and result in view.",
  "Live geometry ideas shaped around clarity instead of software spectacle.",
  "Tools built from real shop use, then tightened until they earn a place.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CADVANTAGE | DATUM</title>
    <meta
      name="description"
      content="CADVANTAGE is the secondary DATUM tools lane for practical shop utilities, setup thinking, live geometry, and toolmaker-built software."
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label="DATUM home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>DATUM</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <section class="page-hero" aria-labelledby="page-title">
          <div>
            <p class="eyebrow">Tools from the bench</p>
            <h1 id="page-title">CADVANTAGE</h1>
            <p class="status-badge">
              <span class="status-dot" aria-hidden="true"></span>
              Coming Soon to Google Play
            </p>
            <p class="lead">
              Practical shop utilities and toolmaker-built software connected to DATUM,
              but secondary to the writing and the work.
            </p>
            <p class="body-copy">
              CADVANTAGE is the tools lane: calculators, setup thinking, live geometry,
              and shop clarity in broad, useful forms. Built from real use, not theory alone.
            </p>
          </div>

          <div class="hero-plate" aria-label="Abstract datum reference plate">
            <span class="plate-label">Tools / Secondary lane</span>
          </div>
        </section>

        <section class="section" aria-labelledby="tools-title">
          <div class="tools-panel">
            <div>
              <p class="eyebrow">What belongs here</p>
              <h2 id="tools-title">Software that respects the bench.</h2>
              <p>
                The point is not to overbuild a platform. The point is to make small,
                accurate utilities that help the user think clearly before the cut, setup,
                sketch, or check.
              </p>
            </div>
            <ul class="tool-list">
              {utilityNotes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        </section>

        <section class="section" aria-labelledby="coming-title">
          <div class="split-feature">
            <div>
              <p class="eyebrow">Coming work</p>
              <h2 id="coming-title">Tools are coming from real shop use.</h2>
            </div>
            <div class="feature-copy">
              <p>
                CADVANTAGE will stay grounded: no launch-date theater, no inflated promises,
                no account system bolted on before the tools prove they deserve it.
              </p>
              <p>
                The lane is for practical utilities that help a maker check the reference,
                understand the geometry, and move with less confusion.
              </p>
              <a class="text-link" href="/writing">Read the DATUM notes</a>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="join-title" id="join">
          <div class="join-block">
            <div>
              <p class="eyebrow">Tool notes</p>
              <h2 id="join-title">Follow the build.</h2>
              <p>
                Bench Notes will carry practical updates as the tools lane becomes ready to show.
              </p>
            </div>

            <!-- STUB: not wired to an email provider yet. Wiring is a separate ticket. -->
            <form class="signup-form">
              <label for="email">Email address</label>
              <div class="form-row">
                <input id="email" name="email" type="email" placeholder="you@example.com" required />
                <button type="submit">Subscribe</button>
              </div>
            </form>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <p>Thomas Craft &middot; checkyourdatum.com</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 8px 14px;
    border: 1px solid rgba(240, 164, 58, 0.5);
    background:
      linear-gradient(rgba(240, 164, 58, 0.08), rgba(240, 164, 58, 0.08)),
      var(--color-surface);
    box-shadow: var(--shadow-amber);
    color: var(--color-amber);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 10px rgba(240, 164, 58, 0.6);
  }
</style>
