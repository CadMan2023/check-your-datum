---
import "../styles/datum-pages.css";
import "../styles/site-build.css";
import { allocation, kitPrice, screenshots, tasks } from "../lib/product-data.mjs";

const navItems = [
  { href: "/writing", label: "Writing" },
  { href: "/story", label: "Story" },
  { href: "/book", label: "Book" },
  { href: "/cadvantage", label: "CADVANTAGE", current: true },
  { href: "#join", label: "Join" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CADVANTAGE | DATUM</title>
    <meta
      name="description"
      content="A machinist’s reference and calculator app for the shop floor, built by a working tool and die maker."
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label="DATUM home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>DATUM</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <div class="datum-build">
          <section class="page-hero cad-hero" aria-labelledby="page-title">
            <div class="cad-hero-title">
              <p class="eyebrow">TOOLS FROM THE BENCH / CADVANTAGE</p>
              <h1 id="page-title">CADVANTAGE</h1>
            </div>

            <div class="cad-hero-copy">
              <p class="status-badge">
                <span class="status-dot" aria-hidden="true"></span>
                Coming Soon to Google Play
              </p>
              <p class="lead">A machinist’s reference and calculator app for the shop floor.</p>
              <p class="subtle">Built by a working tool and die maker.</p>
              <div class="actions">
                <a class="btn primary" href="#toolmaker-kit">Explore the Toolmaker Kit</a>
                <a class="btn" href="#bench-tools">See what it does</a>
              </div>
              <p class="subtle">Android first. Inch-first, with IPR for lathe feeds.</p>
            </div>

            <figure class="hero-art cad-hero-art">
              <div class="caddie-frame">
                <img
                  src="/assets/caddie.webp"
                  alt="Caddie, the blue octopus in a beanie, carrying a lantern."
                  width="960"
                  height="960"
                />
              </div>
              <figcaption>GUIDANCE. PRECISION. CLARITY.</figcaption>
            </figure>
          </section>

          <section class="section" id="bench-tools" aria-labelledby="tasks-title">
            <div class="section-intro">
              <div>
                <p class="eyebrow">WHAT IT DOES</p>
                <h2 id="tasks-title">Keep the work<br />in view.</h2>
              </div>
              <p class="subtle">
                Geometry, calculations, and references for the questions that come up at the bench.
              </p>
            </div>
            <div class="task-grid">
              {
                tasks.map(([n, title, copy]) => (
                  <article class="task">
                    <span class="num" aria-hidden="true">{n} /</span>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="section" id="toolmaker-kit" aria-labelledby="kit-title">
            <div class="section-intro">
              <div>
                <p class="eyebrow">FREE + TOOLMAKER KIT</p>
                <h2 id="kit-title">The everyday tools are free.</h2>
              </div>
              <p class="subtle">One-time purchase. No subscription. No trial.</p>
            </div>
            <div class="split">
              <article class="plan">
                <p class="eyebrow">THE FREE TOOLS</p>
                <h3>Free</h3>
                <ul>{allocation.free.map((feature) => <li>{feature}</li>)}</ul>
                <p class="subtle">Use Calculate or press Enter to run a free triangle calculation.</p>
              </article>
              <article class="plan kit">
                <p class="eyebrow">THE TOOLMAKER KIT</p>
                <h3>Toolmaker Kit</h3>
                <p class="price">{kitPrice}</p>
                <ul>{allocation.kit.map((feature) => <li>{feature}</li>)}</ul>
                <p class="subtle">Restore your purchase through Google Play.</p>
              </article>
            </div>
          </section>

          <section class="section" aria-labelledby="screens-title">
            <div class="section-intro">
              <div>
                <p class="eyebrow">ON YOUR PHONE</p>
                <h2 id="screens-title">A look at the tools.</h2>
              </div>
            </div>
            <div class="screens">
              {
                screenshots.map(({ file, title, alt, caption }) => (
                  <figure class="screen">
                    <div class="app-screen">
                      <img
                        src={`/assets/cadvantage/${file}`}
                        alt={alt}
                        width="709"
                        height="1536"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <figcaption>
                      <strong>{title}</strong>
                      <p>{caption}</p>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </section>

          <section class="section" aria-labelledby="bench-title">
            <p class="eyebrow">BUILT AT THE BENCH</p>
            <h2 id="bench-title">Built for the work<br />in front of you.</h2>
            <div class="bench-copy">
              <p>
                I'm a working tool and die maker. I started CADVANTAGE because it's hard for
                apprentices to get the information they need. Too much of it lives in other
                people's heads, and a lot of apprentices are afraid to ask the question. So I put
                the answers in one place: an angle, a stack height, a hole location, a thread
                measurement, with the geometry and the reference right there in view. That's what
                I'm building.
              </p>
            </div>
            <p class="label">Thomas Craft</p>
          </section>
        </div>

        <section class="section" aria-labelledby="join-title" id="join">
          <div class="join-block">
            <div>
              <p class="eyebrow">Tool notes</p>
              <h2 id="join-title">Follow the build.</h2>
              <p>
                Bench Notes will carry practical updates as the tools lane becomes ready to show.
              </p>
            </div>

            <!-- STUB: not wired to an email provider yet. Wiring is a separate ticket. -->
            <form class="signup-form">
              <label for="email">Email address</label>
              <div class="form-row">
                <input id="email" name="email" type="email" placeholder="you@example.com" required />
                <button type="submit">Subscribe</button>
              </div>
            </form>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <p>Thomas Craft &middot; checkyourdatum.com</p>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Sol's Reset 3 styles (site-build.css) apply inside .datum-build; the site's
     header, join section and footer stay outside it on datum-pages.css. */
  .datum-build {
    background: none;
  }

  /* Below 1024px the hero stacks: heading, copy, then Caddie. From 1024px up Caddie
     takes a right-hand column spanning both rows (see the min-width media query). */
  .cad-hero {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "title"
      "copy"
      "art";
    row-gap: 0;
    border-bottom: 0;
  }

  .cad-hero-title {
    grid-area: title;
  }

  /* Keep the site's H1 look rather than the review fixture's heading rule. */
  .cad-hero h1 {
    margin-bottom: 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 10vw, 7.8rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: 0;
    overflow-wrap: normal;
  }

  .cad-hero-copy {
    grid-area: copy;
    align-self: start;
  }

  .cad-hero-art {
    grid-area: art;
    align-self: start;
    margin: clamp(32px, 6vw, 88px) 0 0;
  }

  /* Caddie: the art is ~65% of its 960px frame (the rest is transparent), so the
     image box (--caddie) runs wider than the column and .caddie-frame clips only
     that empty padding. Visible Caddie ≈ 0.65 × --caddie. Positions below are
     fractions of the image box: Caddie's centre sits at 0.38 from the frame top. */
  .datum-build .cad-hero-art {
    --caddie: clamp(300px, 80vw, 560px);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 0;
    padding-bottom: 6px;
    overflow: visible;
    background: none;
  }

  .caddie-frame {
    display: flex;
    justify-content: center;
    width: 100%;
    overflow: hidden;
  }

  /* Faint amber ring around Caddie in place of the cool-gray one. */
  .datum-build .cad-hero-art::before {
    inset: auto;
    top: calc(var(--caddie) * 0.03);
    left: 50%;
    width: calc(var(--caddie) * 0.7);
    height: calc(var(--caddie) * 0.7);
    border: 1px solid rgba(240, 164, 58, 0.14);
    transform: translateX(-50%);
  }

  /* The page's warm background glow, moved from the body background
     (datum-pages.css: circle at 82% 8%, rgba(180,106,53,0.14) → transparent 31rem)
     to centre on Caddie. Same colour, radius and falloff. It sits in the
     page's bottom layer (z-index -1, behind all text), so this page paints its
     body background on <html> instead and leaves <body> transparent. */
  :global(html) {
    overflow-x: clip;
    background:
      linear-gradient(120deg, rgba(141, 150, 156, 0.045), transparent 30rem),
      var(--color-bg);
  }

  /* Clip at the screen edge so the glow can never cause sideways scrolling. */
  :global(body) {
    overflow-x: clip;
    background: transparent;
  }

  .datum-build .cad-hero-art::after {
    --glow-r: 31rem;
    position: absolute;
    z-index: -1;
    top: calc(var(--caddie) * 0.38 - var(--glow-r));
    left: calc(50% - var(--glow-r));
    width: calc(var(--glow-r) * 2);
    height: calc(var(--glow-r) * 2);
    background: radial-gradient(circle closest-side, rgba(180, 106, 53, 0.14), transparent);
    content: "";
    pointer-events: none;
  }

  .datum-build .cad-hero-art img {
    flex: none;
    width: var(--caddie);
    max-width: none;
    height: auto;
    margin-block: calc(var(--caddie) * -0.12);
  }

  .datum-build .cad-hero-art figcaption {
    position: relative;
    bottom: auto;
    margin-top: 4px;
  }

  /* Sol's sections draw a top rule; drop the site's bottom rule inside the wrapper so lines don't double. */
  .datum-build .section {
    border-bottom: 0;
  }

  @media (min-width: 1024px) {
    /* Caddie in the upper right, spanning the heading and copy rows. */
    .cad-hero {
      grid-template-columns: minmax(0, 1fr) 490px;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "title art"
        "copy art";
      column-gap: 40px;
    }

    .datum-build .cad-hero-art {
      --caddie: 680px;
    }

    /* Lift the figure so Caddie's top sits level with the eyebrow. */
    .cad-hero-art {
      margin-top: calc(var(--caddie) * -0.06);
    }

    /* Shrink the heading only as far as the left column needs: one line, clear of the art. */
    .cad-hero h1 {
      font-size: clamp(3.5rem, calc(14.6vw - 86px), 6.25rem);
      white-space: nowrap;
    }
  }

  @media (max-width: 620px) {
    /* Scale the one long word to the screen so it never runs off the edge on phones. */
    .cad-hero h1 {
      font-size: min(clamp(3.35rem, 18vw, 5rem), 13vw);
    }
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 8px 14px;
    border: 1px solid rgba(240, 164, 58, 0.5);
    background:
      linear-gradient(rgba(240, 164, 58, 0.08), rgba(240, 164, 58, 0.08)),
      var(--color-surface);
    box-shadow: var(--shadow-amber);
    color: var(--color-amber);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 10px rgba(240, 164, 58, 0.6);
  }
</style>
