---
const navItems = [
  { href: "/writing", label: "Writing" },
  { href: "/story", label: "Story" },
  { href: "/book", label: "Book" },
  { href: "/cadvantage", label: "CADVANTAGE" },
  { href: "#join", label: "Join" },
];

const lanes = [
  {
    title: "True Your Mind",
    kicker: "Reference",
    copy: "Essays on reference points, grief, discipline, and the work of getting honest before the next cut is made.",
  },
  {
    title: "Trade Lessons",
    kicker: "Shop",
    copy: "Shop-floor notes on machining, craft, mistakes, tolerances, and what the bench teaches when the part does not care about opinion.",
  },
  {
    title: "The Dispatch",
    kicker: "Field Notes",
    copy: "Field notes from the work, the yard, the tools, and the life around them.",
  },
  {
    title: "CADVANTAGE / Tools",
    kicker: "Utilities",
    copy: "Practical shop utilities and CADVANTAGE work kept close to the bench, secondary to the writing and built from real use.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DATUM | Check Your Datum</title>
    <meta
      name="description"
      content="DATUM is the writing and tools system behind Check Your Datum by Thomas Craft: precision in the shop, clarity in the mind, truth in the work."
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label="DATUM home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>DATUM</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">DATUM / by Thomas Craft</p>
            <h1 id="hero-title">Check Your Datum.</h1>
            <p class="subline">
              <span>Precision in the shop.</span>
              <span>Clarity in the mind.</span>
              <span>Truth in the work.</span>
            </p>
            <p class="hero-text">
              Everything starts from a reference. DATUM is writing, tools, and shop-born
              thinking for measuring from something true before building the next thing.
            </p>
            <div class="hero-actions" aria-label="Homepage actions">
              <a class="button button-primary" href="/writing">Start Reading</a>
              <a class="button button-secondary" href="#work">Explore the Work</a>
            </div>
          </div>

          <div class="instrument-panel" aria-label="Abstract datum target and dial indicator motif">
            <div class="grid-plane"></div>
            <div class="datum-target">
              <span class="axis axis-x"></span>
              <span class="axis axis-y"></span>
              <span class="target-ring ring-one"></span>
              <span class="target-ring ring-two"></span>
              <span class="target-core"></span>
            </div>
            <div class="indicator">
              <span class="indicator-face"></span>
              <span class="indicator-needle"></span>
              <span class="indicator-stem"></span>
            </div>
            <div class="measure-scale" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </section>

        <section class="lanes" id="work" aria-labelledby="lanes-title">
          <div class="section-heading">
            <p class="eyebrow">The work</p>
            <h2 id="lanes-title">A system of measured attention.</h2>
          </div>

          <div class="lane-grid">
            {
              lanes.map((lane) => (
                <article class="lane-card">
                  <p>{lane.kicker}</p>
                  <h3>{lane.title}</h3>
                  <span class="rule" aria-hidden="true"></span>
                  <p>{lane.copy}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="book-feature" aria-labelledby="book-title">
          <div>
            <p class="eyebrow">Book project</p>
            <h2 id="book-title">True Your Mind</h2>
          </div>
          <div class="book-copy">
            <p>
              The deeper book project behind DATUM: a plainspoken study of reference,
              discipline, grief, and the slow work of coming back into alignment.
            </p>
            <p>
              It treats clarity like setup work. Find the datum, check the reading, and
              stop pretending a bad reference can make a true part.
            </p>
            <a class="text-link" href="/book">Read about the book</a>
          </div>
        </section>

        <section class="join-block" id="join" aria-labelledby="join-title">
          <div>
            <p class="eyebrow">Bench Notes</p>
            <h2 id="join-title">Join the list.</h2>
            <p>
              Short dispatches on craft, clarity, tools, and the work of checking your datum.
            </p>
          </div>

          <!-- STUB: not wired to an email provider yet. Wiring is a separate ticket. -->
          <form class="signup-form">
            <label for="email">Email address</label>
            <div class="form-row">
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
              <button type="submit">Join</button>
            </div>
          </form>
        </section>
      </main>

      <footer class="site-footer">
        <p>Thomas Craft &middot; checkyourdatum.com</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --color-bg: #070808;
    --color-surface: #101214;
    --color-surface-2: #171a1d;
    --color-line: #2a2f34;
    --color-text: #f4efe6;
    --color-muted: #a7a095;
    --color-subtle: #6f756f;
    --color-amber: #f0a43a;
    --color-copper: #b46a35;
    --color-steel: #8d969c;
    --color-parchment: #e8dcc6;
    --shadow-amber: 0 0 48px rgba(240, 164, 58, 0.22);
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-bg);
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    background:
      radial-gradient(circle at 76% 14%, rgba(180, 106, 53, 0.16), transparent 34rem),
      linear-gradient(120deg, rgba(141, 150, 156, 0.05), transparent 28rem),
      var(--color-bg);
    color: var(--color-text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 4px;
  }

  .site-shell {
    width: min(1220px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .brand-mark {
    position: relative;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-steel);
    border-radius: 50%;
    box-shadow: inset 0 0 0 7px var(--color-bg), 0 0 22px rgba(240, 164, 58, 0.16);
  }

  .brand-mark::before,
  .brand-mark::after {
    position: absolute;
    content: "";
    background: var(--color-amber);
    opacity: 0.85;
  }

  .brand-mark::before {
    top: 50%;
    left: 5px;
    right: 5px;
    height: 1px;
  }

  .brand-mark::after {
    top: 5px;
    bottom: 5px;
    left: 50%;
    width: 1px;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 20px;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav a {
    border-bottom: 1px solid transparent;
    padding: 6px 0;
  }

  .site-nav a:hover {
    border-color: var(--color-copper);
    color: var(--color-text);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(340px, 0.82fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
    min-height: clamp(640px, calc(100vh - 82px), 760px);
    padding: clamp(36px, 5vw, 64px) 0 clamp(72px, 8vw, 108px);
  }

  .hero-copy {
    max-width: 730px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--color-amber);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    letter-spacing: 0;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(4.3rem, 9.6vw, 8.05rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 4.2rem);
    line-height: 1;
  }

  h3 {
    margin-bottom: 18px;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .subline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.18em 0.32em;
    max-width: 700px;
    margin-bottom: 22px;
    color: var(--color-parchment);
    font-size: clamp(1.18rem, 1.65vw, 1.55rem);
    line-height: 1.42;
  }

  .subline span {
    display: inline-block;
  }

  .hero-text {
    max-width: 610px;
    color: var(--color-muted);
    font-size: 1.03rem;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--color-line);
    padding: 0 20px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease,
      background 160ms ease;
  }

  .button-primary {
    border-color: rgba(240, 164, 58, 0.7);
    background: linear-gradient(180deg, rgba(240, 164, 58, 0.18), rgba(180, 106, 53, 0.12));
    box-shadow: var(--shadow-amber);
    color: var(--color-text);
  }

  .button-secondary {
    background: rgba(16, 18, 20, 0.72);
    color: var(--color-muted);
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .instrument-panel {
    position: relative;
    min-height: clamp(430px, 46vw, 540px);
    overflow: hidden;
    border: 1px solid rgba(141, 150, 156, 0.22);
    background:
      linear-gradient(rgba(240, 164, 58, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 164, 58, 0.05) 1px, transparent 1px),
      linear-gradient(150deg, rgba(255, 255, 255, 0.04), transparent 52%),
      var(--color-surface);
    background-size: 44px 44px, 44px 44px, auto, auto;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.44), var(--shadow-amber);
  }

  .instrument-panel::after {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(7, 8, 8, 0.48), transparent 28%),
      radial-gradient(circle at 52% 48%, transparent 34%, rgba(7, 8, 8, 0.2) 72%);
  }

  .grid-plane {
    position: absolute;
    inset: 26px;
    border: 1px solid rgba(141, 150, 156, 0.2);
  }

  .datum-target {
    position: absolute;
    top: 51%;
    left: 48%;
    width: min(66%, 330px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .target-ring,
  .target-core,
  .axis,
  .indicator-face,
  .indicator-needle,
  .indicator-stem {
    position: absolute;
    display: block;
  }

  .target-ring {
    inset: 0;
    border: 1px solid rgba(141, 150, 156, 0.72);
    border-radius: 50%;
  }

  .ring-two {
    inset: 24%;
    border-color: rgba(240, 164, 58, 0.65);
    box-shadow: 0 0 40px rgba(240, 164, 58, 0.12);
  }

  .target-core {
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 28px rgba(240, 164, 58, 0.7);
    transform: translate(-50%, -50%);
  }

  .axis {
    background: rgba(244, 239, 230, 0.62);
  }

  .axis-x {
    top: 50%;
    left: -8%;
    width: 116%;
    height: 1px;
  }

  .axis-y {
    top: -8%;
    left: 50%;
    width: 1px;
    height: 116%;
  }

  .indicator {
    position: absolute;
    right: 9%;
    top: 10%;
    width: 134px;
    height: 176px;
    z-index: 1;
  }

  .indicator-face {
    top: 0;
    right: 0;
    width: 118px;
    height: 118px;
    border: 1px solid rgba(244, 239, 230, 0.6);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244, 239, 230, 0.1), rgba(16, 18, 20, 0.94) 68%);
  }

  .indicator-needle {
    top: 58px;
    right: 58px;
    width: 48px;
    height: 1px;
    background: var(--color-amber);
    transform: rotate(-38deg);
    transform-origin: right center;
  }

  .indicator-stem {
    top: 110px;
    right: 58px;
    width: 1px;
    height: 66px;
    background: rgba(141, 150, 156, 0.7);
  }

  .measure-scale {
    position: absolute;
    right: 28px;
    bottom: 28px;
    left: 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 54px;
    border-bottom: 1px solid rgba(141, 150, 156, 0.34);
    z-index: 1;
  }

  .measure-scale span {
    width: 1px;
    height: 22px;
    background: rgba(141, 150, 156, 0.6);
  }

  .measure-scale span:nth-child(2n) {
    height: 36px;
    background: rgba(240, 164, 58, 0.5);
  }

  .lanes,
  .book-feature,
  .join-block {
    border-top: 1px solid var(--color-line);
    padding: clamp(76px, 8vw, 104px) 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
  }

  .lane-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .lane-card {
    display: flex;
    min-height: 315px;
    flex-direction: column;
    border: 1px solid rgba(141, 150, 156, 0.22);
    background:
      linear-gradient(180deg, rgba(244, 239, 230, 0.04), transparent 54%),
      var(--color-surface);
    padding: 28px;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .lane-card:hover {
    border-color: rgba(240, 164, 58, 0.38);
    background:
      linear-gradient(180deg, rgba(240, 164, 58, 0.055), transparent 58%),
      var(--color-surface);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.24);
    transform: translateY(-3px);
  }

  .lane-card > p:first-child {
    margin-bottom: 18px;
    color: var(--color-copper);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lane-card > p:last-child,
  .book-copy p,
  .join-block p {
    color: var(--color-muted);
    line-height: 1.75;
  }

  .lane-card > p:last-child {
    margin-bottom: 0;
  }

  .rule {
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 20px;
    background: linear-gradient(90deg, var(--color-amber), transparent);
    opacity: 0.58;
  }

  .book-feature,
  .join-block {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .book-feature {
    border-bottom: 1px solid var(--color-line);
  }

  .book-copy {
    max-width: 650px;
    border-left: 1px solid rgba(240, 164, 58, 0.36);
    padding-left: 28px;
  }

  .text-link {
    display: inline-flex;
    margin-top: 10px;
    color: var(--color-amber);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .join-block {
    align-items: center;
  }

  .signup-form {
    width: 100%;
    border: 1px solid rgba(141, 150, 156, 0.24);
    background: rgba(16, 18, 20, 0.66);
    padding: 22px;
  }

  .signup-form label {
    display: block;
    margin-bottom: 10px;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .form-row {
    display: flex;
    gap: 10px;
  }

  input,
  button {
    min-height: 48px;
    border: 1px solid var(--color-line);
    font: inherit;
  }

  input {
    width: 100%;
    background: #0b0c0d;
    color: var(--color-text);
    padding: 0 14px;
  }

  input::placeholder {
    color: var(--color-subtle);
  }

  button {
    cursor: pointer;
    background: var(--color-amber);
    color: #11100e;
    padding: 0 22px;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer {
    border-top: 1px solid var(--color-line);
    padding: 32px 0 44px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin-bottom: 0;
  }

  @media (max-width: 920px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 40px;
    }

    .hero-copy {
      max-width: 760px;
    }

    .instrument-panel {
      min-height: 420px;
    }

    .lane-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .book-feature,
    .join-block {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(100% - 24px, 1180px);
    }

    .site-header {
      padding-top: 18px;
    }

    .site-nav {
      gap: 4px 14px;
      font-size: 0.72rem;
    }

    .hero {
      padding-bottom: 68px;
    }

    h1 {
      font-size: clamp(3.2rem, 20vw, 5rem);
    }

    .hero-actions,
    .form-row {
      flex-direction: column;
    }

    .button,
    button {
      width: 100%;
    }

    .instrument-panel {
      min-height: 330px;
    }

    .datum-target {
      width: min(72%, 270px);
    }

    .indicator {
      right: 2%;
      top: 8%;
      transform: scale(0.72);
    }

    .lanes,
    .book-feature,
    .join-block {
      padding: 64px 0;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .lane-grid {
      grid-template-columns: 1fr;
    }

    .lane-card {
      min-height: auto;
      padding: 24px;
    }

    .book-copy {
      padding-left: 18px;
    }
  }
</style>
